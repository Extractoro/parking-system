# Merged from the .gitignore files of the Web and DPC kits (identical except comments).

# Local configuration and access tokens
.env
.env.*
!.env.example
!.env.template
tokens.txt
tokens-*.txt
tokens_*.txt

# Generated datasets, simulator state and experiment runs
data/
rows.csv
state.jsonl
runs/
results/raw/

# Local environments and dependencies
.venv/
venv/
node_modules/

# Python and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime logs and operating-system metadata
logs/
*.log
.DS_Store
Thumbs.db

# Report previews (the .docx is committed, its PDF and page images are not)
docs/reports/out/*.pdf
docs/reports/out/pages/
docs/reports/out/~$*

# Internal working material: stage plans and lab reports stay local only
docs/plans/
docs/reports/

# Packages for DL (scripts/submit.sh)
submit/
