# Copy as .env (cp .env.example .env); docker compose reads it. Every value has the same default
# in compose.yaml, so a missing .env changes nothing.
# Merged from the .env.example of both kits. Course of each variable: # Web, # DPC, # shared.

# ---------------------------------------------------------------------------------------------
# Published ports (README.md, section 5); change if a port is busy and update checks.yaml.
# ---------------------------------------------------------------------------------------------
# shared
POSTGRES_PORT=5432
KAFKA_HOST_PORT=9094
KAFKA_UI_PORT=8085
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Web
NGINX_PORT=8080
APP_A_PORT=8001
APP_B_PORT=8002
GATEWAY_A_PORT=8091
GATEWAY_B_PORT=8092
SIM_PORT=8090
FLAGS_PORT=8099
REDIS_PORT=6379
JAEGER_PORT=16686
# DPC
API_PORT=8000
RAY_DASHBOARD_PORT=8265
SPARK_MASTER_UI_PORT=8280
SPARK_JOB_UI_PORT=4040
SPARK_STREAM_UI_PORT=4041
SPARK_HISTORY_PORT=18080
ETCD_PORT=2379

# ---------------------------------------------------------------------------------------------
# Clients run outside Compose (React + Vite dev server): CORS and WebSocket Origin.
# Inside the containers both are passed as CLIENT_ORIGIN.
# ---------------------------------------------------------------------------------------------
# Web
WEB_CLIENT_ORIGIN=http://localhost:5173
# DPC
DPC_CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------------------------
# Database limits (shared PostgreSQL), Web D2.6:
#   2 x POOL_SIZE (app-a, app-b) + app-canary + publisher + worker + router + gateway-a/b
#   + api + ray nodes + spark (runner, stream) + coordinators + migrate/psql < PG_MAX_CONNECTIONS
#   upper bound with POOL_SIZE=10 (each Web process has its own pool of this size):
#   Web 8 x 10 = 80; DPC api 10 + ray-head/ray-worker x2 up to 3 x 10 = 40;
#   spark jobs + coordinators ~10; migrate/psql/reserve ~10  =>  ~140 < 200
# ---------------------------------------------------------------------------------------------
# shared
PG_MAX_CONNECTIONS=200
# Web
POOL_SIZE=10

# ---------------------------------------------------------------------------------------------
# Web: experiment modes; the skeleton reads them in web/server/app/config.py.
# ---------------------------------------------------------------------------------------------
INVARIANT_MODE=protected
RATE_LIMIT_PER_MIN=120
JWT_REVOCATION=on
# lab 3: lifetime of a login session (opaque token), hours
SESSION_TTL_H=8
OTEL_ENABLED=off

# ---------------------------------------------------------------------------------------------
# Web: simulator of card C09 – barrier (web/tools/external-sim/README.md).
# POST /open, 1-3 s; "no connection" 10 % = SIM_ERROR_SHARE (temporary 503); no rejections.
# ---------------------------------------------------------------------------------------------
SIM_NAME=barrier
SIM_ROUTE=/open
SIM_DELAY_MS=1000-3000
SIM_REJECT_SHARE=0
SIM_ERROR_SHARE=0.10
SIM_REJECT_REASONS="шлагбаум несправний"
SIM_SEED=

# ---------------------------------------------------------------------------------------------
# Web lab 6: stop migrations after this version (empty - all); image tags of the versions.
# MIGRATE_TO applies to the shared migrations/ folder (numbering common to Web and DPC).
# ---------------------------------------------------------------------------------------------
# shared
MIGRATE_TO=
# Web + DPC (tag of every image built from this repository)
APP_TAG=dev
# Web
CANARY_TAG=dev
CANARY_WEIGHT=0

# ---------------------------------------------------------------------------------------------
# DPC
# ---------------------------------------------------------------------------------------------
API_TOKEN=dev-token

# Topic of card C09; one partition for the ordered experiment O5.3.
EVENTS_TOPIC=barrier-events
EVENTS_PARTITIONS=1

# Experiment modes; the skeleton reads them in dpc/api/app/config.py and dpc/spark/jobs/*.py.
QUEUE_CAPACITY=50
WORKERS=4
RESOURCE_MODE=locked
EXECUTION=local
IN_FLIGHT_LIMIT=8
RECEIVER_DELAY_MS=0
SPARK_AQE=on
BROADCAST_THRESHOLD=10m
WATERMARK_MINUTES=10
LEASE_TTL_S=5
FENCING=on
